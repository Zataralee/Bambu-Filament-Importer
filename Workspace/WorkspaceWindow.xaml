<Window x:Class="BambuFilamentImporter.Workspace.WorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:workspace="clr-namespace:BambuFilamentImporter.Workspace"
 Title="Bambu Filament Importer" Width="1280" Height="900" MinWidth="1020" MinHeight="720"
 Icon="/BambuFilamentImporter;component/BFI Icon.ico" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <HierarchicalDataTemplate DataType="{x:Type workspace:FilamentTreeNode}" ItemsSource="{Binding Children}">
   <Grid Margin="3,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <CheckBox IsChecked="{Binding Product.IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasProduct,Converter={StaticResource BoolVisibility}}" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding HasDetail,Converter={StaticResource BoolVisibility}}"/></StackPanel>
   </Grid>
  </HierarchicalDataTemplate>
  <Style TargetType="TreeViewItem">
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsTreeSelected,Mode=TwoWay}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False" Width="20" Height="26" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{TemplateBinding Foreground}" AutomationProperties.Name="Expand or collapse group">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><TextBlock x:Name="Arrow" Text="▸" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="▾"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="Row" Grid.Column="1" CornerRadius="4" Background="Transparent" Padding="3,0"><ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/></Border>
     <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
     <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087B43"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#087B43"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="9,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,7,27,7" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="42"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="10,9"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Cell" TargetType="TextBlock"><Setter Property="Padding" Value="8,3"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self},Path=Text}"/></Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image Source="/BambuFilamentImporter;component/BFI Icon.png" Width="64" Height="64" Margin="0,0,15,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Bambu Filament Importer application icon"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Bambu Filament Importer" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="BuildLabel" Text="Compact workspace · By Zataralee" Style="{StaticResource Muted}"/></StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click"/><Button Content="Report a problem" Click="ReportBug_Click" Margin="0"/></StackPanel><CheckBox x:Name="DarkCheck" Content="Dark mode" Click="Dark_Click" HorizontalAlignment="Right"/><TextBlock x:Name="StudioStatus" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
  </Grid>
  <StackPanel Grid.Row="1">
   <Border x:Name="AppUpdateBanner" Visibility="Collapsed" Background="{DynamicResource SelectionBrush}" Padding="12" CornerRadius="7" Margin="0,0,0,8"><DockPanel><Button x:Name="UpdateAppButton" DockPanel.Dock="Right" Content="Update BFI" Click="UpdateApp_Click" Margin="12,0,0,0"/><TextBlock x:Name="AppUpdateText" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
   <Border x:Name="LibraryUpdateBanner" Visibility="Collapsed" Background="{DynamicResource SelectionBrush}" Padding="12" CornerRadius="7" Margin="0,0,0,8"><DockPanel><Button DockPanel.Dock="Right" Content="Review library updates" Click="Downloads_Click" Margin="12,0,0,0"/><TextBlock x:Name="LibraryUpdateText" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
  </StackPanel>
  <TabControl x:Name="Navigation" Grid.Row="2" SelectionChanged="Navigation_Changed" Padding="0" BorderThickness="0" Background="Transparent">
   <TabItem Header="Add Filaments" Padding="20,10">
    <ScrollViewer x:Name="AddScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
    <Grid Height="{Binding ViewportHeight, ElementName=AddScroll}" MinHeight="600">
     <Grid x:Name="BrowsePanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Find your filament" Style="{StaticResource Heading}"/><TextBlock Text="Choose products, printers and nozzles. Review every change before installing." Style="{StaticResource Muted}"/></StackPanel>
      <Grid Grid.Row="1" Margin="0,16,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Search filaments" Margin="0,0,0,4"/><TextBox x:Name="ProductSearch" TextChanged="ProductFilter_Changed" AutomationProperties.Name="Search filaments"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Manufacturer" Margin="0,0,0,4"/><ComboBox x:Name="VendorFilter" SelectionChanged="ProductFilter_Changed"/></StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Download libraries…" Click="Downloads_Click"/><Button Content="Open package…" Click="OpenPackage_Click" Margin="0"/></StackPanel>
      </Grid>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,9"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Select visible" Click="SelectVisible_Click" Padding="9,5"/><Button Content="Clear selection" Click="ClearSelection_Click" Padding="9,5" Margin="0"/></StackPanel><TextBlock x:Name="CatalogCount" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
        <TreeView x:Name="ProductsTree" Grid.Row="1" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Filaments by brand, type, and name"/>
        <Border x:Name="EmptyLibraryPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" Padding="24"><StackPanel VerticalAlignment="Center"><TextBlock Text="Choose your manufacturer libraries" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Download the manufacturers you use, then select products here. Existing Studio profiles are already available in My Library." Style="{StaticResource Muted}" Margin="0,10,0,16"/><Button Content="Browse filament libraries" Click="Downloads_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
        <TextBlock Grid.Row="2" Text="Downloaded packages are separate from profiles installed in your library." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
       </Grid>
       <Border Grid.Column="2" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Install selection" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SelectionCount" Style="{StaticResource Muted}" Margin="0,5,0,12"/><TextBlock Text="Bambu System Library" FontWeight="SemiBold"/><TextBlock Text="Grouped by brand in Bambu Studio. BFI keeps a recovery backup of imported profiles." Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,10"/>
         <CheckBox x:Name="UseCustomCheck" Click="ImportOption_Changed" ToolTipService.ShowDuration="30000"><CheckBox.ToolTip><ToolTip><TextBlock MaxWidth="330" TextWrapping="Wrap" Text="Use custom presets to avoid Bambu Studio updates overwriting system imports. Not recommended for large filament collections: Studio puts custom presets in one long Custom list."/></ToolTip></CheckBox.ToolTip><TextBlock Text="Import into custom presets instead" TextWrapping="Wrap"/></CheckBox>
         <TextBlock Text="Existing custom tuning is preserved." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/><TextBlock Text="Printers &amp; nozzles" FontWeight="SemiBold"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,12"><ItemsControl x:Name="PrinterChoices"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><CheckBox Content="{Binding Target.ModelName}" IsChecked="{Binding IsSelected,Mode=TwoWay}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Nozzles}" Margin="20,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Button x:Name="ReviewButton" Grid.Row="2" Content="Review changes →" Style="{StaticResource Primary}" Click="Review_Click" Margin="0"/>
       </Grid></Border>
      </Grid>
     </Grid>
     <Grid x:Name="ReviewPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Review your changes" Style="{StaticResource Heading}"/><TextBlock x:Name="ReviewSummary" Style="{StaticResource Muted}" Margin="0,0,0,16"/></StackPanel>
      <DataGrid x:Name="ReviewGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell}"/><DataGridTextColumn Header="Library" Binding="{Binding Location}" Width="180" ElementStyle="{StaticResource Cell}"/><DataGridTextColumn Header="Planned change" Binding="{Binding Action}" Width="290" ElementStyle="{StaticResource Cell}"/></DataGrid.Columns></DataGrid>
      <Border Grid.Row="2" Background="{DynamicResource SelectionBrush}" Padding="14" CornerRadius="7" Margin="0,16"><TextBlock Text="A complete backup is created before installation. Existing settings are retained when printer coverage is extended. Program Files is not modified by this workspace." TextWrapping="Wrap"/></Border>
      <DockPanel Grid.Row="3"><Button x:Name="InstallButton" DockPanel.Dock="Right" Content="Install into System Library" Style="{StaticResource Primary}" Click="Install_Click" Margin="0"/><Button Content="← Back to selection" Click="Back_Click" HorizontalAlignment="Left"/></DockPanel>
     </Grid>
     <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" Margin="30"><TextBlock Text="Your filaments are ready" Style="{StaticResource Heading}"/><TextBlock x:Name="SuccessSummary" TextWrapping="Wrap" Margin="0,12,0,25"/><StackPanel Orientation="Horizontal"><Button Content="View my library" Style="{StaticResource Primary}" Click="ViewLibrary_Click"/><Button Content="Add more filaments" Click="Back_Click"/></StackPanel></StackPanel>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem Header="My Library" Padding="20,10">
    <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
    <Grid Height="{Binding ViewportHeight, ElementName=LibraryScroll}" MinHeight="450"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16"><TextBlock Text="Filaments in your library" Style="{StaticResource Heading}"/><TextBlock Text="Select a product, then explicitly choose the profile you want to edit." Style="{StaticResource Muted}"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="LibrarySearch" TextChanged="LibraryFilter_Changed" ToolTip="Search brands, types, or filaments" AutomationProperties.Name="Search current library" Margin="0,0,0,10"/><TreeView x:Name="LibraryTree" Grid.Row="1" Padding="5" SelectedItemChanged="LibrarySelection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Custom and system libraries by brand, type, and name"/></Grid>
      <Border Grid.Column="2" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="EditorTitle" Text="Choose a filament" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Printer profile / edit scope" Margin="0,14,0,4"/><ComboBox x:Name="ProfilePicker" DisplayMemberPath="Label" SelectionChanged="ProfileSelection_Changed"/><TextBlock x:Name="ScopeText" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/></StackPanel>
       <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="CategoryFilter" SelectionChanged="SettingsFilter_Changed" Margin="0,0,10,0"/><TextBox x:Name="SettingSearch" Grid.Column="1" TextChanged="SettingsFilter_Changed" ToolTip="Search settings" AutomationProperties.Name="Search settings"/></Grid>
       <DataGrid x:Name="SettingsGrid" Grid.Row="2" BeginningEdit="Setting_BeginningEdit" RowHeight="44" MinRowHeight="40"><DataGrid.Columns><DataGridTextColumn Header="Setting" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource Cell}"/><DataGridTextColumn Header="Value" Binding="{Binding Value,UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource Cell}"/><DataGridTextColumn Header="Origin" Binding="{Binding Origin}" IsReadOnly="True" Width="190" ElementStyle="{StaticResource Cell}"/></DataGrid.Columns></DataGrid>
       <StackPanel Grid.Row="3" Margin="0,13,0,0"><TextBlock x:Name="EditStatus" Style="{StaticResource Muted}" Margin="0,0,0,10"/><WrapPanel><Button x:Name="SaveButton" Content="Save changes" Style="{StaticResource Primary}" Click="Save_Click" IsEnabled="False"/><Button Content="Discard edits" Click="Discard_Click"/><Button x:Name="ResetOverrideButton" Content="Use inherited value" Click="ResetOverride_Click"/><Button x:Name="RemoveButton" Content="Remove profile…" Click="Remove_Click"/></WrapPanel></StackPanel>
      </Grid></Border>
     </Grid>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem Header="Maintenance" Padding="20,10">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
     <TextBlock Text="Keep your library ready" Style="{StaticResource Heading}"/><TextBlock Text="Check coverage, download packages, and recover from backups." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
     <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Bambu Studio update recovery" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StudioRecoveryText" Text="BFI keeps imported system profiles and filament configuration for recovery after a Studio update." Style="{StaticResource Muted}" Margin="0,8,0,12"/><Button Content="Check Studio update recovery…" Click="StudioRecovery_Click" HorizontalAlignment="Left"/></StackPanel></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Library health &amp; recovery" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HealthText" Text="Run a check to validate the active catalog and AMS IDs." Style="{StaticResource Muted}" Margin="0,9,0,15"/><WrapPanel><Button Content="Check library" Click="Audit_Click"/><Button Content="Review missing coverage" Click="RepairCoverage_Click"/></WrapPanel><TextBlock Text="Repair only products already present in your active library." Style="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Manufacturer packages" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Downloads refresh your manufacturer package library. Installed profiles are not overwritten. Import new products or missing coverage from Add Filaments." Style="{StaticResource Muted}" Margin="0,9,0,15"/><Button Content="Browse downloads &amp; updates…" Click="Downloads_Click" HorizontalAlignment="Left"/><TextBlock Text="Existing tuned profiles are preserved; package downloads do not overwrite them." Style="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Backups &amp; restore" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,12"><Button Content="Create backup" Click="Backup_Click"/><Button Content="Restore selected backup…" Click="RestoreSelected_Click"/><Button Content="Open backup file…" Click="RestoreFile_Click"/><Button Content="Open backup folder" Click="OpenBackupFolder_Click"/></WrapPanel><ListBox x:Name="BackupList" MaxHeight="160" DisplayMemberPath="Name"/><TextBlock Text="Restore merges the backup into the selected library and may replace matching settings. You will review its scope before applying it." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Advanced library tools" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Rename products or manufacturers, remove a whole manufacturer, repair AMS IDs, or import legacy packages using the existing advanced editor." Style="{StaticResource Muted}" Margin="0,8,0,12"/><Button Content="Open advanced tools" Click="AdvancedTools_Click" HorizontalAlignment="Left"/></StackPanel></Border>
     <Expander Header="Activity &amp; technical details" Margin="0,16"><StackPanel><TextBox x:Name="ActivityLog" IsReadOnly="True" TextWrapping="Wrap" Height="190" VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="WorkspacePath" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><ProgressBar x:Name="BusyProgress" DockPanel.Dock="Right" Width="110" Height="5" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Loading…" TextWrapping="Wrap" Style="{StaticResource Muted}"/></DockPanel>
 </Grid>
</Window>
