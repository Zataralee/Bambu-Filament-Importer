<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BambuFilamentImporter.Preview</AssemblyName>
    <Version>0.5.0-preview.1</Version>
    <Product>BFI Redesign Preview</Product>
    <ApplicationIcon>..\BFI Icon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="PreviewApp.xaml" />
    <ApplicationDefinition Include="PreviewApp.xaml" />
    <ProjectReference Include="..\BambuFilamentImporter.csproj" />
    <Content Include="..\packages\manufacturers\*.bflib" Link="Libraries\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
