<Window x:Class="BambuFilamentImporter.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a Bug" Icon="BFI Icon.ico"
        Width="820" Height="760" MinWidth="700" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="ReportAccentBrush" Color="#16834F"/>
        <SolidColorBrush x:Key="ReportAccentHoverBrush" Color="#116B41"/>

        <Style x:Key="ReportField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style x:Key="PrimaryReportButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ReportAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinWidth" Value="138"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ReportAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid MaxWidth="860" MaxHeight="820" Margin="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource ReportAccentBrush}" CornerRadius="2"/>
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="Report a Bug" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Create a private-on-disk diagnostic package for a GitHub report."
                               FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,22,0,18">
                <StackPanel>
                    <TextBlock Text="ISSUE SUMMARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBox x:Name="SummaryText" Style="{StaticResource ReportField}" MaxLength="120"
                             Height="40" VerticalContentAlignment="Center" Margin="0,6,0,14"/>

                    <TextBlock Text="STEPS TO REPRODUCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBox x:Name="StepsText" Style="{StaticResource ReportField}" Height="108" MaxLength="10000"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="EXPECTED BEHAVIOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBox x:Name="ExpectedText" Style="{StaticResource ReportField}" Height="92" MaxLength="10000"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ACTUAL BEHAVIOR OR ERROR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBox x:Name="ActualText" Style="{StaticResource ReportField}" Height="92" MaxLength="10000"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="14"/>
                                <CheckBox x:Name="IncludeLogsCheck" IsChecked="True" Content="Include sanitized BFI logs" Margin="0,7,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PrinterSummaryText" Grid.Column="1" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Privacy" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1"
                                       Text="No Bambu Studio configuration files are included. Known usernames, user paths, IP addresses, printer serial numbers, and access codes are removed. Review the ZIP before attaching it."
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nothing is uploaded until you attach the ZIP and submit the GitHub issue."
                               FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" MinWidth="92" Padding="14,9" Margin="0,0,9,0"/>
                        <Button x:Name="CreateReportButton" Content="Create Report" Click="CreateReport_Click"
                                IsDefault="True" Style="{StaticResource PrimaryReportButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
