<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BambuFilamentImporter</AssemblyName>
    <StartupObject>BambuFilamentImporter.Program</StartupObject>
    <ApplicationIcon>BFI Icon.ico</ApplicationIcon>
    <Version>0.4.7</Version>
    <Authors>Zataralee</Authors>
    <Product>Bambu Filament Importer</Product>
    <Description>Native Windows utility for managing and importing manufacturer filament libraries into Bambu Studio.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Resource Include="BFI Icon.ico" />
    <Resource Include="BFI Icon.png" />
  </ItemGroup>

</Project>
